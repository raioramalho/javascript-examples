generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Autorizacao {
  DESENVOLVEDOR
  ADMINISTRADOR
  GERENTE
  VENDEDOR
  CLIENTE
  USUARIO

  @@map("AUTORIZACAO")
}

enum UnidadeDeMedida {
  TONELADA
  QUILOGRAMA
  GRAMA
  MILIGRAMA
  QUILOMETRO
  METRO
  MILIMETRO
  CENTRIMETRO
  LITROS
  MILILITROS
  CAIXA

  kg
  g
  mg
  km
  m
  mm
  cm
  L
  mL
  cx

  @@map("UNIDADEDEMEDIDA")
}

enum Status {
  PAGO
  CRIADO
  BAIXADO
  EM_ANDAMENTO
  EM_FILA
  EM_ATRASO
  EM_DIA
  EM_PROCESSAMENTO
  FATURADO
  PENDENTE
  PROCESSADO
  RECEBIDO
  SOLICITADO
  CANCELADO
  ATIVO
  RETIFICADO
  AGUARDANDO_PAGAMENTO
  AGUARDANDO_LIBERACAO
  AGUARDANDO_PROCESSAMENTO
}

enum Genero {
  MASCULINO
  FEMININO
  NAO_BINARIO
  OUTROS
  NAO_INFORMAR
}

model Blacklist {
  //TODO: Campos da tabela.
  CODBLACK Int       @id @default(autoincrement())
  UUID     String    @unique @default(uuid())
  TOKEN    String    @unique
  //TODO: Relação de tabela.
  USUARIO  Usuarios  @relation("TOKENS_INCLUSOS", fields: [USUINC], references: [CODUSU])
  USUINC   Int
  //TODO: Normalização de tabela.
  USUALT   Int?
  DATAINC  DateTime  @default(now())
  DATAALAT DateTime? @updatedAt

  @@map("BLACKLIST")
}

model Pessoas {
  //TODO: Campos da tabela.
  CODPES      Int        @id @default(autoincrement())
  UUID        String     @unique @default(uuid())
  NOME        String // quando pessoa jurídica recebe NOMEFANTASIA
  SOBRENOME   String // quando pessoa jurídica recebe RAZAOSOCIAL
  CPFCNPJ     String?    @unique // quando pessoa jurídica recebe CNPJ
  TELEFONE    String?
  //TODO: Relações de tabela.
  GENERO      Genero?    @default(NAO_INFORMAR)
  USUARIO     Usuarios?
  EMPRESAS    Empresas[]
  USUARIO_INC Usuarios?  @relation("PESSOAS_INCLUSAS", fields: [USUINC], references: [CODUSU])
  //TODO: Normalização de tabela.
  USUINC      Int?
  USUALT      Int?
  DATAINC     DateTime   @default(now())
  DATAALT     DateTime?  @updatedAt

  @@map("PESSOAS")
}

model Clientes {
  //TODO: Campos da tabela.
  CODCLI          Int              @id @default(autoincrement())
  UUID            String           @unique @default(uuid())
  USUARIOCLIENTE  Usuarios?        @relation("USUARIO_CLIENTE", fields: [CODUSU], references: [CODUSU])
  CODUSU          Int?
  NOMEFANTAZIA    String
  RAZAOSOCIAL     String
  CPFCNPJ         String?
  EMAIL           String?          @default("")
  TELEFONE        String?          @default("")
  //TODO: Relações de tabela.
  EMPRESA         Empresas         @relation(fields: [CODEMP], references: [CODEMP])
  CODEMP          Int
  // EMPRESAORIGEM   Empresas?        @relation("EMPRESA_ORIGEM", fields: [CODEMPORIGEM], references: [CODEMP])
  CODEMPORIGEM    Int?
  PEDIDOS         Pedidos[]
  TABELASDEPRECOS TabelaDePrecos[]
  //TODO: Normalização de tabela.
  USUARIO_INC     Usuarios         @relation("CLIENTES_INCLUSOS", fields: [USUINC], references: [CODUSU])
  USUINC          Int
  USUALT          Int?
  DATAINC         DateTime         @default(now())
  DATAALT         DateTime?        @updatedAt

  @@map("CLIENTES")
}

model Empresas {
  //TODO: Campos da tabela.
  CODEMP       Int     @id @default(autoincrement())
  UUID         String  @unique @default(uuid())
  NOMEFANTAZIA String // quando pessoa física recebe NOME
  RAZAOSOCIAL  String // quando pessoa física recebe SOBRENOME
  CPFCNPJ      String? // quando pessoa física recebe CPF

  //TODO: Relações de tabela.
  PESSOA       Pessoas? @relation(fields: [CODPES], references: [CODPES])
  CODPES       Int?     @unique
  CODEMPORIGEM Int? // FK para identificar a empresa de origem

  ACESSOS        Acessos[]
  TABELADEPRECOS TabelaDePrecos[]
  PARAMETROS     Parametros[]
  PRODUTOS       Produtos[]
  IMAGENS        Imagens[]
  PEDIDOS        Pedidos[]
  FINANCEIROS    Financeiro[]
  BOLETOS        BoletosFinanceiros[]
  USUARIOS       Usuarios[]           @relation("INTEGRANTE_EMPRESA")
  EMAILCONFIGS   EmailConfig[]
  EMAILMESSAGES  EmailMessages[]
  // CLIENTES       Clientes[]           @relation("EMPRESA_ORIGEM")
  CLIENTES       Clientes[]
  USUARIO_INC    Usuarios?            @relation("USUARIO_INCLUSAO", fields: [USUINC], references: [CODUSU])
  USUINC         Int?
  //TODO: Normalização de tabela.
  USUALT         Int?
  DATAINC        DateTime             @default(now())
  DATAALT        DateTime?            @updatedAt

  @@map("EMPRESAS")
}

model Usuarios {
  //TODO: Campos da tabela.
  CODUSU      Int         @id @default(autoincrement())
  UUID        String      @unique @default(uuid())
  AUTORIZACAO Autorizacao @default(USUARIO)
  CODEXTERNO  Int?
  EMAIL       String      @unique
  SENHAATUAL  String
  SENHAANTIGA String
  STATUS      Status      @default(ATIVO)
  //TODO: Relações de tabela.

  PESSOA         Pessoas?   @relation(fields: [CODPES], references: [CODPES])
  CODPES         Int?       @unique
  USUARIOCLIENTE Clientes[] @relation("USUARIO_CLIENTE")

  // Adicione a relação para USUINC
  BLACKLIST        Blacklist[]      @relation("TOKENS_INCLUSOS")
  PARAMETROS       Parametros[]     @relation("PARAMETROS_INCLUSOS")
  IMAGENS          Imagens[]
  PRODUTOS         Produtos[]       @relation("PRODUTOS_INCLUSOS")
  PEDIDOS          Pedidos[]        @relation("PEDIDOS_INCLUSOS")
  PESSOAS          Pessoas[]        @relation("PESSOAS_INCLUSAS")
  CLIENTES         Clientes[]       @relation("CLIENTES_INCLUSOS")
  TABELASDEPRECOS  TabelaDePrecos[] @relation("TABELASDEPRECOS_INCLUSAS")
  ITENSDATABELA    ItensDaTabela[]  @relation("ITENSDATABELA_INCLUSOS")
  VENDEDORTABELA   TabelaDePrecos[] @relation("VENDEDOR_TABELA_DE_PRECO")
  ACESSOS          Acessos[]
  ACESSOS_INCLUSOS Acessos[]        @relation("ACESSOS_INCLUSOS")

  EMPRESAS Empresas[] @relation("USUARIO_INCLUSAO")

  FINANCEIROS Financeiro[]         @relation("FINANCEIROS_INCLUSOS")
  BOLETOS     BoletosFinanceiros[] @relation("BOLETO_INCLUSOS")

  MAILCONFIGS  EmailConfig[]   @relation("MAILCONFIGS_INCLUSOS")
  MAILMESSAGES EmailMessages[] @relation("MAILMESSAGES_SOLICITADAS")

  EMPRESA Empresas? @relation("INTEGRANTE_EMPRESA", fields: [CODEMP], references: [CODEMP])
  CODEMP  Int?

  //TODO: Normalização de tabela.
  USUINC  Int?
  USUALT  Int?
  DATAINC DateTime  @default(now())
  DATAALT DateTime? @updatedAt

  @@map("USUARIOS")
}

model Acessos {
  //TODO: Campos da tabela.
  CODACESS    Int       @id @default(autoincrement())
  UUID        String    @unique @default(uuid())
  //TODO: Relações de tabela.
  EMPRESA     Empresas? @relation(fields: [CODEMP], references: [CODEMP])
  CODEMP      Int?
  USUARIO     Usuarios? @relation(fields: [CODUSU], references: [CODUSU])
  CODUSU      Int?
  USUARIO_INC Usuarios? @relation("ACESSOS_INCLUSOS", fields: [USUINC], references: [CODUSU])
  USUINC      Int

  USUALT  Int?
  //TODO: Normalização de tabela.
  DATAINC DateTime  @default(now())
  DATAALT DateTime? @updatedAt

  @@map("ACESSO")
}

model Parametros {
  //TODO: Campos da tabela.
  CODPARAM    Int      @id @default(autoincrement())
  UUID        String   @unique @default(uuid())
  PARAMETRO   String
  DESCRICAO   String
  VALOR       String
  //TODO: Relações de tabela.
  EMPRESA     Empresas @relation(fields: [CODEMP], references: [CODEMP])
  CODEMP      Int
  USUARIO_INC Usuarios @relation("PARAMETROS_INCLUSOS", fields: [USUINC], references: [CODUSU])
  USUINC      Int
  USUALT      Int?

  //TODO: Normalização de tabela.
  DATAINC DateTime  @default(now())
  DATAALT DateTime? @updatedAt

  @@map("PARAMETROS")
}

model Produtos {
  //TODO: Campos de tabela.
  CODPROD    Int     @id @default(autoincrement())
  UUID       String  @unique @default(uuid())
  SKU        String  @unique
  NCM        String? @unique
  PRODUTO    String
  DESCRICAO  String
  FABRICANTE String

  ESTOQUE Int      @default(0)
  //TODO: Relacoes de tabela.
  EMPRESA Empresas @relation(fields: [CODEMP], references: [CODEMP])
  CODEMP  Int

  IMAGENS     Imagens[]
  DETALHES    ProdutoDetalhes[]
  PEDIDOITENS PedidoItens[]
  ITEMTABELA  ItensDaTabela[]

  //TODO: Normalização de tabela.
  USUARIO_INC Usuarios  @relation("PRODUTOS_INCLUSOS", fields: [USUINC], references: [CODUSU])
  USUINC      Int
  USUALT      Int?
  DATAINC     DateTime  @default(now())
  DATAALT     DateTime? @updatedAt

  @@map("PRODUTOS")
}

model ProdutoDetalhes {
  //TODO: Campos de tabela.
  CODPRODDET   Int              @id @default(autoincrement())
  UUID         String           @unique @default(uuid())
  PRODUTO      Produtos         @relation(fields: [CODPROD], references: [CODPROD])
  CODPROD      Int
  ALTURA       Int?             @default(0)
  LARGURA      Int?             @default(0)
  COMPRIMENTO  Int?             @default(0)
  PROFUNDIDADE Int?             @default(0)
  PESO         Int?             @default(0)
  MEDIDA       UnidadeDeMedida?
  //TODO: Normalização de tabela.
  USUALT       Int?
  DATAINC      DateTime         @default(now())
  DATAALT      DateTime?        @updatedAt

  @@map("PRODUTODETALHES")
}

model Pedidos {
  //TODO: Campos de tabela.
  CODPED     Int           @id @default(autoincrement())
  UUID       String        @unique @default(uuid())
  DESCRICAO  String?
  SUBTOTAL   Int           @default(0)
  VALORTOTAL Int           @default(0)
  DESCONTO   Int           @default(0)
  //TODO: Relacoes de tabela.
  EMPRESA    Empresas      @relation(fields: [CODEMP], references: [CODEMP])
  CODEMP     Int
  CLIENTE    Clientes?     @relation(fields: [CODCLI], references: [CODCLI])
  CODCLI     Int?
  ITENS      PedidoItens[]
  STATUS     Status        @default(CRIADO)
  //TODO: Normalização de tabela.
  VENDEDOR   Usuarios      @relation("PEDIDOS_INCLUSOS", fields: [USUINC], references: [CODUSU])
  USUINC     Int
  USUALT     Int?
  DATAINC    DateTime      @default(now())
  DATAALT    DateTime?     @updatedAt

  @@map("PEDIDOS")
}

model PedidoItens {
  //TODO: Campos de tabela.
  CODPEDITEM Int       @id @default(autoincrement())
  UUID       String    @unique @default(uuid())
  //TODO: Relacoes de tabela.
  PEDIDO     Pedidos   @relation(fields: [CODPED], references: [CODPED])
  CODPED     Int
  PRODUTO    Produtos  @relation(fields: [CODPROD], references: [CODPROD])
  CODPROD    Int
  QTD        Int       @default(0)
  //TODO: Normalização de tabela.
  USUALT     Int?
  DATAINC    DateTime  @default(now())
  DATAALT    DateTime? @updatedAt

  @@map("PEDIDOITENS")
}

model Financeiro {
  //TODO: Campos de tabela.
  CODFIN         Int                 @id @default(autoincrement())
  UUID           String              @unique @default(uuid())
  EMISSAO        DateTime
  VENCIMENTO     DateTime
  RECEBIMENTO    DateTime?
  VALOR          Decimal
  VALORRECEBIDO  Decimal?
  STATUS         Status              @default(BAIXADO)
  PERIODOINICIAL DateTime?
  PERIODOFINAL   DateTime?
  BOLETO         BoletosFinanceiros? @relation(fields: [CODBOLFIN], references: [CODBOLFIN])
  CODBOLFIN      Int?

  //TODO: Relacoes de tabela.
  EMPRESA     Empresas @relation(fields: [CODEMP], references: [CODEMP])
  CODEMP      Int
  USUARIO_INC Usuarios @relation("FINANCEIROS_INCLUSOS", fields: [USUINC], references: [CODUSU])
  USUINC      Int

  //TODO: Normalização de tabela.
  USUALT  Int?
  DATAINC DateTime  @default(now())
  DATAALT DateTime? @updatedAt

  @@map("FINANCEIRO")
}

enum TabelaPadrao {
  SIM
  NAO
}

model TabelaDePrecos {
  //TODO: Campos de tabela.
  CODTABPREC Int          @id @default(autoincrement())
  UUID       String       @unique @default(uuid())
  DESCRICAO  String?
  DATAVIGOR  DateTime?
  PADRAO     TabelaPadrao @default(NAO)

  //TODO: Relacoes de tabela.
  EMPRESA    Empresas        @relation(fields: [CODEMP], references: [CODEMP])
  CODEMP     Int
  VENDEDORES Usuarios[]      @relation("VENDEDOR_TABELA_DE_PRECO")
  CLIENTES   Clientes[]
  ITENS      ItensDaTabela[]

  //TODO: Normalização de tabela.
  USUARIO_INC Usuarios  @relation("TABELASDEPRECOS_INCLUSAS", fields: [USUINC], references: [CODUSU])
  USUINC      Int
  USUALT      Int?
  DATAINC     DateTime  @default(now())
  DATAALT     DateTime? @updatedAt

  @@map("TABELADEPRECOS")
}

model ItensDaTabela {
  //TODO: Campos de tabela.
  CODITENTAB    Int            @id @default(autoincrement())
  UUID          String         @unique @default(uuid())
  CUSTO         Int?
  VALOR         Int
  VALORMAXIMO   Int?
  VALORMINIMO   Int?
  //TODO: Relacoes de tabela.
  TABELADEPRECO TabelaDePrecos @relation(fields: [CODTABPREC], references: [CODTABPREC])
  CODTABPREC    Int
  PRODUTO       Produtos       @relation(fields: [CODPROD], references: [CODPROD])
  CODPROD       Int

  //TODO: Normalização de tabela.
  USUARIO_INC Usuarios? @relation("ITENSDATABELA_INCLUSOS", fields: [USUINC], references: [CODUSU])
  USUINC      Int
  USUALT      Int?
  DATAINC     DateTime  @default(now())
  DATAALT     DateTime? @updatedAt

  @@map("ITENSDATABELA")
}

model BoletosFinanceiros {
  //TODO: Campos de tabela.
  CODBOLFIN   Int          @id @default(autoincrement())
  UUID        String       @unique @default(uuid())
  BOLETO      String
  //TODO: Relacoes de tabela.
  EMPRESA     Empresas     @relation(fields: [CODEMP], references: [CODEMP])
  CODEMP      Int
  USUARIO_INC Usuarios     @relation("BOLETO_INCLUSOS", fields: [USUINC], references: [CODUSU])
  USUINC      Int
  FINANCEIRO  Financeiro[]
  //TODO: Normalização de tabela.
  USUALT      Int?
  DATAINC     DateTime     @default(now())
  DATAALT     DateTime?    @updatedAt

  @@map("BOLETOFINANCEIRO")
}

model EmailConfig {
  //TODO: Campos de tabela.
  CODMAILCONF   Int             @id @default(autoincrement())
  UUID          String          @unique @default(uuid())
  HOST          String
  PORT          Int
  USER          String
  PASS          String
  //TODO: Relacoes de tabela.
  EMAILMESSAGES EmailMessages[]
  EMPRESA       Empresas        @relation(fields: [CODEMP], references: [CODEMP])
  CODEMP        Int
  USUARIO_INC   Usuarios        @relation("MAILCONFIGS_INCLUSOS", fields: [USUINC], references: [CODUSU])
  USUINC        Int

  //TODO: Normalização de tabela.
  USUALT  Int?
  DATAINC DateTime  @default(now())
  DATAALT DateTime? @updatedAt

  @@map("EMAILCONFIG")
}

model EmailMessages {
  //TODO: Campos de tabela.
  CODMAIMESSAGE Int         @id @default(autoincrement())
  UUID          String      @unique @default(uuid())
  AUTOR         String
  DESTINATARIO  String
  ASSUNTO       String
  CONTEUDO      String
  RETORNO       String
  //TODO: Relacoes de tabela.
  EMAILCONFIG   EmailConfig @relation(fields: [CODMAILCONF], references: [CODMAILCONF])
  CODMAILCONF   Int
  EMPRESA       Empresas    @relation(fields: [CODEMP], references: [CODEMP])
  CODEMP        Int
  USUARIO_INC   Usuarios    @relation("MAILMESSAGES_SOLICITADAS", fields: [USUINC], references: [CODUSU])
  USUINC        Int

  //TODO: Normalização de tabela.
  USUALT  Int?
  DATAINC DateTime  @default(now())
  DATAALT DateTime? @updatedAt

  @@map("EMAILMESSAGE")
}

model Imagens {
  //TODO: Campos de tabela.
  CODIMG  Int       @id @default(autoincrement())
  UUID    String    @unique @default(uuid())
  IMAGEM  String
  //TODO: Relacoes de tabela.
  EMPRESA Empresas? @relation(fields: [CODEMP], references: [CODEMP])
  CODEMP  Int?
  PRODUTO Produtos? @relation(fields: [CODPROD], references: [CODPROD])
  CODPROD Int?
  USUARIO Usuarios? @relation(fields: [CODUSU], references: [CODUSU])
  CODUSU  Int?

  //TODO: Normalização de tabela.
  @@map("IMAGENS")
}
